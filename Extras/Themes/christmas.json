{
  "base": "vs-dark",
  "inherit": true,
  "rules": [
    { "token": "", "foreground": "E6E6E6", "background": "0A0A0A" },
    { "token": "comment", "foreground": "1CCF6B", "fontStyle": "italic" },
    { "token": "number", "foreground": "FF4D4D" },
    { "token": "string", "foreground": "FFD966" },
    { "token": "keyword", "foreground": "FF2E2E", "fontStyle": "bold" },
    { "token": "operator", "foreground": "E6E6E6" },
    { "token": "delimiter", "foreground": "AAAAAA" },
    { "token": "variable", "foreground": "1EEA79" },
    { "token": "constant", "foreground": "77D9FF" },
    { "token": "type", "foreground": "FFD966" },
    { "token": "attribute.name.css", "foreground": "FFD966" },
    { "token": "attribute.value.css", "foreground": "1EEA79" },
    { "token": "selector.css", "foreground": "FF3C3C", "fontStyle": "bold" },
    { "token": "property.css", "foreground": "FFD966" },
    { "token": "delimiter.css", "foreground": "00DB95" },
    { "token": "number.css", "foreground": "77D9FF" },
    { "token": "string.css", "foreground": "FFD966" },
    { "token": "tag.css", "foreground": "FF3C3C" },
    { "token": "tag.html", "foreground": "FF3C3C", "fontStyle": "bold" },
    { "token": "attribute.name.html", "foreground": "FF8C4A" },
    { "token": "attribute.value.html", "foreground": "1EEA79" },
    { "token": "delimiter.html", "foreground": "FFD966" },
    { "token": "metatag.html", "foreground": "FF0000" },
    { "token": "keyword.js", "foreground": "FF2E2E" },
    { "token": "number.js", "foreground": "FF4D4D", "fontStyle": "italic" },
    { "token": "string.js", "foreground": "FFD966", "fontStyle": "italic" },
    { "token": "identifier.js", "foreground": "FFD966" },
    { "token": "delimiter.js", "foreground": "FF2E2E" },
    { "token": "comment.js", "foreground": "1CCF6B" },
    { "token": "string.key.json", "foreground": "FF2E2E" },
    { "token": "string.value.json", "foreground": "FFD700", "fontStyle": "italic" },
    { "token": "number.json", "foreground": "FFD700", "fontStyle": "italic" },
    { "token": "keyword.json", "foreground": "FF8C4A" }
  ],
  "colors": {
    "editor.background": "#0A0A0A",
    "editor.foreground": "#E6E6E6",
    "editorCursor.foreground": "#FFFFFF",
    "editor.selectionBackground": "#202020",
    "editor.inactiveSelectionBackground": "#161616",
    "editor.lineHighlightBackground": "#151515",
    "editorLineNumber.foreground": "#555",
    "editorLineNumber.activeForeground": "#FF2E2E",
    "minimap.findMatchHighlight": "#FF2E2E",
    "minimap.selectionHighlight": "#1EEA79",
    "scrollbarSlider.background": "#FF2E2E33",
    "scrollbarSlider.hoverBackground": "#FF2E2E55",
    "scrollbarSlider.activeBackground": "#FF2E2E77",
    "editorError.foreground": "#FF3333",
    "editorWarning.foreground": "#FFD966",
    "editorInfo.foreground": "#1EEA79"
  }
}
