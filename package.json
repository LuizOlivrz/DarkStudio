{
  "name": "darkstudio",
  "productName": "DarkStudio",
  "version": "26.11.19",
  "description": "DarkStudio web e desktop no mesmo repositório",
  "main": "Desktop/main.js",
  "author": "LuizOlivrz",
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --enable-logging",
    "dist": "npm run dist:win",
    "dist:win": "npm run version:sync && electron-builder --win nsis msi portable",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "check:desktop": "node --check Desktop/main.js && node --check Desktop/preload.js && node --check Desktop/desktop-bridge.js && node --check Desktop/media-session.js && node -e \"JSON.parse(require('fs').readFileSync('package.json', 'utf8'))\"",
    "dist:msi": "npm run version:sync && node scripts/gerenciar-dist-msi.js preparar && electron-builder --win msi --x64 && node scripts/gerenciar-dist-msi.js finalizar",
    "version:sync": "node scripts/sincronizar-versao.js"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.darkstudio.desktop",
    "productName": "DarkStudio",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DarkStudio",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-Windows-Portable-${arch}.${ext}"
    },
    "files": [
      "index.html",
      "help/**/*",
      "Extras/**/*",
      "Desktop/**/*",
      "package.json",
      "node_modules/monaco-editor/**/*",
      "!**/*.map",
      "!**/.git/**"
    ],
    "asar": true,
    "executableName": "DarkStudio",
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DarkStudio",
      "runAfterFinish": true,
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "msiProjectCreated": "./scripts/corrigir-msi-sem-icone.js",
    "asarUnpack": [
      "node_modules/windows-media-sessions/**/*"
    ]
  },
  "dependencies": {
    "monaco-editor": "0.52.2",
    "extract-zip": "^2.0.1"
  },
  "optionalDependencies": {
    "windows-media-sessions": "^1.0.3"
  }
}
